# Copy this file to .env and adjust values for your environment.
# .env is gitignored and should never be committed.

# Path to the data directory (DuckDB database and CSV imports).
# docker-compose defaults to /srv/hl-dashboard/data if this is unset (Raspberry Pi layout).
DATA_DIR=./data

# --- HL automatic transaction download (weekly cron job, Sundays 00:00) ---
# If HL_USERNAME is unset the weekly download is skipped; you can still drop
# CSV exports into data/imports/raw_transactions/{ISA,SIPP}/ manually.
HL_USERNAME=              # HL client number (on your statements)
HL_DATE_OF_BIRTH=         # DDMMYY, e.g. 150590
HL_PASSWORD=
HL_SECURE_NUMBER=         # 6-digit secure number
# Account IDs: in HL, open the account > Transaction history > export CSV;
# the URL contains /account/XX/ — XX is the ID.
HL_ISA_ACCOUNT_ID=
HL_SIPP_ACCOUNT_ID=

# Optional HL download settings
# SMS one-time password — only needed on the very first login from a new session.
# The script exits asking for it; re-run with HL_OTP=<code>.
# HL_OTP=
# Where the browser session is persisted (default: <data_dir>/hl_session.json)
# HL_SESSION_PATH=
# Days of history fetched per run (default: 90; ingestion de-duplicates)
# HL_LOOKBACK_DAYS=90

# Morningstar unofficial API token — embedded in Morningstar's own web pages.
# The default value works as of 2025; if fetches start returning 401/403,
# inspect the Network tab on morningstar.co.uk to find the current token.
# MORNINGSTAR_API_TOKEN=9vehuxllxs

# Telegram notifications and query bot (Phases 7a/7b)
# Create a bot via @BotFather to get the token; get your chat ID from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Anthropic API key — used by the Telegram query bot (Phase 7b)
# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the Claude model used by the bot (default: claude-haiku-4-5-20251001)
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# Optional: backend URL used by the bot / eval harness (default: http://backend:8000;
# use http://localhost:8000 when running locally)
# BACKEND_URL=http://localhost:8000
